{
    "npcId": "npc_cassandra",
    "dialogues": [
        {
            "id": "default",
            "speaker": "카산드라",
            "text": "안녕?. 무슨 일 있니?",
            "startQuest": "",
            "completeQuest": "",
            "next": "main_000_default",
            "choices": []
        },
        {
            "id": "main_000_default",
            "speaker": "카산드라",
            "text": "...이건, 내가 예전에 쓰던 일기잖아? 어떻게 이게 여기 있지.",
            "startQuest": "main_000",
            "completeQuest": "",
            "next": "main_000_talk",
            "choices": []
        },
        {
            "id": "main_000_talk",
            "speaker": "카산드라",
            "text": "정신없이 지내다 보니 언제 흘렸는지도 몰랐네. 일단 가지고 있어야겠어.",
            "startQuest": "",
            "completeQuest": "main_000",
            "next": "",
            "choices": []
        },
        {
            "id": "main_001_default",
            "speaker": "카산드라",
            "text": "저기... 혹시 시간 괜찮다면 내 부탁 하나 들어줄 수 있을까? 근처 던전 쪽을 좀 조사해줬으면 하는데.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "조사해볼게.",
                    "next": "main_001_accept",
                    "startQuest": "main_001",
                    "completeQuest": ""
                },
                {
                    "text": "지금은 좀 바빠.",
                    "next": "main_001_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_001_accept",
            "speaker": "카산드라",
            "text": "고마워. 조심해서 다녀와.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_001_reject",
            "speaker": "카산드라",
            "text": "그래, 급할 건 없지. 준비되면 다시 얘기해줘.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_001_running",
            "speaker": "카산드라",
            "text": "던전 안쪽은 좀 살펴봤어? 발밑 조심하고.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_001_complete",
            "speaker": "카산드라",
            "text": "무사히 돌아왔구나, 다행이야.",
            "startQuest": "",
            "completeQuest": "main_001",
            "next": "main_001_reward",
            "choices": []
        },
        {
            "id": "main_001_reward",
            "speaker": "카산드라",
            "text": "고마워, 이거 받아.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_002_default",
            "speaker": "카산드라",
            "text": "버섯 마수 세 마리 처치, 부탁해도 될까? 마을 사람들이 꽤 불안해하고 있어.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "내가 처리하고 올게.",
                    "next": "main_002_accept",
                    "startQuest": "main_002",
                    "completeQuest": ""
                },
                {
                    "text": "잠시만 기다려줘.",
                    "next": "main_002_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_002_accept",
            "speaker": "카산드라",
            "text": "고마워. 조심해서 다녀와.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_002_reject",
            "speaker": "카산드라",
            "text": "알겠어. 준비되면 말해줘.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_002_running",
            "speaker": "카산드라",
            "text": "버섯 마수는 다 처리했어? 냄새가 좀 지독할 텐데.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_002_complete",
            "speaker": "카산드라",
            "text": "세 마리 다 처리했다고? 수고했어.",
            "startQuest": "",
            "completeQuest": "main_002",
            "next": "main_002_reward",
            "choices": []
        },
        {
            "id": "main_002_reward",
            "speaker": "카산드라",
            "text": "그런데... 앞으로 더 위험한 던전들을 조사하려면, 혼자서는 무리일 것 같아. 함께할 동료를 찾아보는 게 어때?",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_003_default",
            "speaker": "카산드라",
            "text": "셀레네라는 애가 있는데, 실력은 확실해. 가서 동료가 되어달라고 부탁해볼래?",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "알겠어, 찾아가볼게.",
                    "next": "main_003_accept",
                    "startQuest": "main_003",
                    "completeQuest": ""
                },
                {
                    "text": "생각 좀 해볼게.",
                    "next": "main_003_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_003_accept",
            "speaker": "카산드라",
            "text": "고마워. 분명 든든한 힘이 되어줄 거야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_003_reject",
            "speaker": "카산드라",
            "text": "그래, 급할 건 없지.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_003_running",
            "speaker": "카산드라",
            "text": "셀레네는 만나봤어? 낯을 좀 가리는 편이지만 나쁜 애는 아니야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_004_default",
            "speaker": "카산드라",
            "text": "셀레네와 함께 야생 던전 쪽을 조사해줘. 마녀사냥단이 그 근처에 숨어있다는 소문이 있어.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "알겠습니다, 다녀올게요.",
                    "next": "main_004_accept",
                    "startQuest": "main_004",
                    "completeQuest": ""
                },
                {
                    "text": "아직 준비가 안 됐어요.",
                    "next": "main_004_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_004_accept",
            "speaker": "카산드라",
            "text": "조심해서 다녀와. 거미 마수들이 많을 거야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_004_reject",
            "speaker": "카산드라",
            "text": "알겠어. 준비되면 다시 말해줘.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_004_running",
            "speaker": "카산드라",
            "text": "거미 마수들은 처리하고 있어? 조심해, 그 녀석들 독을 품고 있으니까.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_004_complete",
            "speaker": "카산드라",
            "text": "거미들을 다 처리했구나. 은신처에 가까워지고 있는 것 같아.",
            "startQuest": "",
            "completeQuest": "main_004",
            "next": "main_004_reward",
            "choices": []
        },
        {
            "id": "main_004_reward",
            "speaker": "카산드라",
            "text": "조금만 더 안쪽으로 들어가 보자. 아직 끝난 게 아니야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_005_default",
            "speaker": "카산드라",
            "text": "이번엔 늑대인간들이 나타났대. 야생 던전 더 깊은 곳을 조사해줘.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "알겠어, 바로 갈게.",
                    "next": "main_005_accept",
                    "startQuest": "main_005",
                    "completeQuest": ""
                },
                {
                    "text": "잠시만 정비하고 갈게.",
                    "next": "main_005_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_005_accept",
            "speaker": "카산드라",
            "text": "고마워. 늑대인간들은 무리 지어 다니니 조심해.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_005_reject",
            "speaker": "카산드라",
            "text": "그래, 충분히 정비하고 출발해.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_005_running",
            "speaker": "카산드라",
            "text": "늑대인간들, 아직인가? 그 녀석들 무리 지어 다니니까 조심해.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_005_complete",
            "speaker": "카산드라",
            "text": "다 처리했구나. 이 정도면 은신처 코앞일 거야.",
            "startQuest": "",
            "completeQuest": "main_005",
            "next": "main_005_reward",
            "choices": []
        },
        {
            "id": "main_005_reward",
            "speaker": "카산드라",
            "text": "이제 마을을 어지럽히는 그 우두머리를 처치할 차례야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_006_default",
            "speaker": "카산드라",
            "text": "야생 던전의 보스, 그게 이 모든 일의 원흉일 거야. 처치해서 던전을 잠재워줘.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "제가 보스를 쓰러뜨릴게요.",
                    "next": "main_006_accept",
                    "startQuest": "main_006",
                    "completeQuest": ""
                },
                {
                    "text": "조금 더 준비가 필요해요.",
                    "next": "main_006_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_006_accept",
            "speaker": "카산드라",
            "text": "믿고 있을게. 절대 무리하지는 말고.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_006_reject",
            "speaker": "카산드라",
            "text": "그래, 보스는 강할 테니 철저히 준비해.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_006_running",
            "speaker": "카산드라",
            "text": "보스는 아직이야? 절대 무리하지 마.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_006_complete",
            "speaker": "카산드라",
            "text": "보스를 처치했다고?! 야생 던전이 다시 잠잠해지겠어.",
            "startQuest": "",
            "completeQuest": "main_006",
            "next": "main_006_reward",
            "choices": []
        },
        {
            "id": "main_006_reward",
            "speaker": "카산드라",
            "text": "정말 큰 일을 해냈어. 그런데 다음 조사를 위해선 동료가 한 명 더 필요할 것 같아.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_007_default",
            "speaker": "카산드라",
            "text": "라이아라는 애를 찾아가 봐. 요즘 마음 둘 곳을 못 찾고 방황한다던데, 너라면 설득할 수 있을 거야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "제가 가서 설득해볼게요.",
                    "next": "main_007_accept",
                    "startQuest": "main_007",
                    "completeQuest": ""
                },
                {
                    "text": "다른 동료부터 찾고 싶어요.",
                    "next": "main_007_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_007_accept",
            "speaker": "카산드라",
            "text": "고마워. 라이아도 분명 너를 보면 마음을 열 거야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_007_reject",
            "speaker": "카산드라",
            "text": "알겠어. 네 선택을 존중할게.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_007_running",
            "speaker": "카산드라",
            "text": "라이아는 만나봤어? 쉽게 마음을 여는 애는 아니지만...",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_008_default",
            "speaker": "카산드라",
            "text": "라이아까지 함께해줘서 든든하네. 이번엔 불의 던전이야. 이상한 마력이 느껴진다는데, 원인을 조사해줘.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "불의 던전으로 출발하자.",
                    "next": "main_008_accept",
                    "startQuest": "main_008",
                    "completeQuest": ""
                },
                {
                    "text": "잠시 정비가 필요해.",
                    "next": "main_008_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_008_accept",
            "speaker": "카산드라",
            "text": "조심해, 불의 던전은 뜨겁고 위험하니까.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_008_reject",
            "speaker": "카산드라",
            "text": "그래, 화상 입지 않게 단단히 준비해.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_008_running",
            "speaker": "카산드라",
            "text": "불의 던전 안쪽은 뜨거울 텐데, 괜찮아?",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_008_complete",
            "speaker": "카산드라",
            "text": "던전을 다 돌아봤구나. 원인이 될 만한 건 좀 찾았어?",
            "startQuest": "",
            "completeQuest": "main_008",
            "next": "main_008_reward",
            "choices": []
        },
        {
            "id": "main_008_reward",
            "speaker": "카산드라",
            "text": "새끼 드래곤이 폭주하고 있다니... 더 커지기 전에 막아야 해.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_009_default",
            "speaker": "카산드라",
            "text": "폭주하는 새끼 드래곤들을 처치해줘. 더 커지면 손 쓸 수 없게 될 거야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "새끼 드래곤들을 막을게요.",
                    "next": "main_009_accept",
                    "startQuest": "main_009",
                    "completeQuest": ""
                },
                {
                    "text": "생각 좀 해볼게요.",
                    "next": "main_009_reject",
                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "main_009_accept",
            "speaker": "카산드라",
            "text": "불을 뿜으니 각별히 조심해.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_009_reject",
            "speaker": "카산드라",
            "text": "그래, 준비되면 바로 시작해줘.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_009_running",
            "speaker": "카산드라",
            "text": "드래곤들은 처리했어? 불 뿜는 거 조심해.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_009_complete",
            "speaker": "카산드라",
            "text": "다 처치했구나. 폭주는 좀 가라앉은 것 같아.",
            "startQuest": "",
            "completeQuest": "main_009",
            "next": "main_009_reward",
            "choices": []
        },
        {
            "id": "main_009_reward",
            "speaker": "카산드라",
            "text": "하지만 근본적인 원인은 아직이야. 던전 깊은 곳의 진짜 주인을 상대해야 할 것 같아.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "main_010_default",
            "speaker": "카산드라",
            "text": "불의 던전을 다스리는 존재를 처치해줘. 그래야 폭주가 완전히 멈출 거야.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": [
                {
                    "text": "불의 주인을 처치하고 올게.",
                    "next": "main_010_accept",
                    "startQuest": "main_010",
                    "completeQuest": ""
                },
                {
                    "text": "조금 더 준비하고 갈게.",
                    "next": "main_010_reject",
