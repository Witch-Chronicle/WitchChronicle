{
  "npcId": "npc_cassandra",
  "dialogues": [
    {
      "id": "default",
      "speaker": "카산드라",
      "text": "어서 오렴. 무슨 일로 선생님을 찾아왔니?",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_000_default",
      "choices": []
    },
    {
      "id": "main_000_default",
      "speaker": "카산드라",
      "text": "...어머, 이건 내가 예전에 쓰던 일기잖아? 어떻게 여기에 떨어져 있었을까?",
      "startQuest": "main_000",
      "completeQuest": "",
      "next": "main_000_talk",
      "choices": []
    },
    {
      "id": "main_000_talk",
      "speaker": "카산드라",
      "text": "바쁘게 지내다 보니 분실한 줄도 몰랐구나. 소중한 기록이니 잘 보관해야겠어.",
      "startQuest": "",
      "completeQuest": "main_000",
      "next": "main_001_default",
      "choices": []
    },
    {
      "id": "main_001_default",
      "speaker": "카산드라",
      "text": "버섯 마수 세 마리를 퇴치하는 일을 부탁해도 될까? 마을 주민들이 불안해하고 있단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "제가 처리하고 올게요.",
          "next": "main_001_accept",
          "startQuest": "main_001",
          "completeQuest": ""
        },
        {
          "text": "잠시만 기다려 주세요.",
          "next": "main_001_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_001_accept",
      "speaker": "카산드라",
      "text": "참 착하구나. 안전을 최우선으로 생각하고 다녀오렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_001_reject",
      "speaker": "카산드라",
      "text": "알았단다. 충분히 준비가 되면 언제든 말해주렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_001_running",
      "speaker": "카산드라",
      "text": "버섯 마수들은 잘 해결하고 있니? 독한 냄새 때문에 힘들진 않고?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_001_complete",
      "speaker": "카산드라",
      "text": "세 마리 모두 깔끔하게 처리했구나! 정말 훌륭해요, 수고 많았단다.",
      "startQuest": "",
      "completeQuest": "main_001",
      "next": "main_001_reward",
      "choices": []
    },
    {
      "id": "main_001_reward",
      "speaker": "카산드라",
      "text": "애써줘서 정말 고마워. 이건 열심히 노력한 보상이란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_002_default",
      "choices": []
    },
    {
      "id": "main_002_default",
      "speaker": "카산드라",
      "text": "저기... 혹시 시간 괜찮다면 내 부탁 하나만 들어줄 수 있을까? 근처 던전 쪽을 가서 한번 살펴봐 주었으면 한단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "제가 조사해 볼게요.",
          "next": "main_002_accept",
          "startQuest": "main_002",
          "completeQuest": ""
        },
        {
          "text": "지금은 좀 바빠요.",
          "next": "main_002_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_002_accept",
      "speaker": "카산드라",
      "text": "고마워라. 다치지 않게 조심해서 다녀오렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_002_reject",
      "speaker": "카산드라",
      "text": "그래, 급하게 서두를 필요는 없단다. 차분히 준비되면 다시 찾아오렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_002_running",
      "speaker": "카산드라",
      "text": "던전 안쪽 조사는 잘 진행되고 있니? 발밑이 위험하니 조심하렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_002_complete",
      "speaker": "카산드라",
      "text": "무사히 다녀왔구나. 별일 없어서 정말 다행이란다.",
      "startQuest": "",
      "completeQuest": "main_002",
      "next": "main_002_reward",
      "choices": []
    },
    {
      "id": "main_002_reward",
      "speaker": "카산드라",
      "text": "그런데... 앞으로 더 위험한 던전을 조사하려면 혼자서보다는 동료가 있는 게 좋겠구나. 함께할 동료를 찾아보는 건 어떨까?",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_003_default",
      "choices": []
    },
    {
      "id": "main_003_default",
      "speaker": "카산드라",
      "text": "‘셀레네’라는 아이가 있는데 실력이 참 뛰어난 친구란다. 가서 함께해 달라고 설득해 볼 수 있겠니?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "네, 찾아가 볼게요.",
          "next": "main_003_accept",
          "startQuest": "main_003",
          "completeQuest": ""
        },
        {
          "text": "생각 좀 해볼게요.",
          "next": "main_003_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_003_accept",
      "speaker": "카산드라",
      "text": "고마워라. 분명 너에게 아주 든든한 조력자가 되어줄 거란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_003_reject",
      "speaker": "카산드라",
      "text": "그래, 중요한 결정이니 천천히 생각해 보렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_003_running",
      "speaker": "카산드라",
      "text": "셀레네는 만나보았니? 이곳 저곳 돌아다니면 찾을수 있을꺼야.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_004_default",
      "speaker": "카산드라",
      "text": "셀레네와 함께 녹색 밀림을 조사해 줄 수 있겠니? 그 근처에 마녀사냥단이 숨어있다는 소문이 있거든.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "알겠습니다, 다녀올게요.",
          "next": "main_004_accept",
          "startQuest": "main_004",
          "completeQuest": ""
        },
        {
          "text": "아직 준비가 안 됐어요.",
          "next": "main_004_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_004_accept",
      "speaker": "카산드라",
      "text": "거미 마수들이 많으니 방심하지 말고 조심해서 다녀오렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_004_reject",
      "speaker": "카산드라",
      "text": "그래, 준비가 부족하면 위험하니까. 준비되면 다시 말하렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_004_running",
      "speaker": "카산드라",
      "text": "거미 마수들은 잘 퇴치하고 있니? 무서운 독을 품고 있으니 끝까지 주의해야 한단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_004_complete",
      "speaker": "카산드라",
      "text": "거미들을 모두 퇴치했구나! 은신처에 한 걸음 더 가까워진 것 같아.",
      "startQuest": "",
      "completeQuest": "main_004",
      "next": "main_004_reward",
      "choices": []
    },
    {
      "id": "main_004_reward",
      "speaker": "카산드라",
      "text": "조금만 더 안쪽으로 들어가 보자꾸나. 끝까지 집중력을 잃지 마렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_005_default",
      "choices": []
    },
    {
      "id": "main_005_default",
      "speaker": "카산드라",
      "text": "이번엔 늑대인간들이 나타났다고 하네. 녹색 밀림 더 깊은 곳까지 조사를 부탁해도 될까?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "네, 바로 다녀올게요.",
          "next": "main_005_accept",
          "startQuest": "main_005",
          "completeQuest": ""
        },
        {
          "text": "잠시만 정비하고 갈게요.",
          "next": "main_005_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_005_accept",
      "speaker": "카산드라",
      "text": "고마워라. 늑대인간들은 무리를 지어 다니니 항상 주변을 경계하렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_005_reject",
      "speaker": "카산드라",
      "text": "그래, 제대로 정비하고 출발하는 게 훌륭한 자세란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_005_running",
      "speaker": "카산드라",
      "text": "늑대인간 처치는 진행 중이니? 무리로 공격해 오니 다치지 않게 조심하렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_005_complete",
      "speaker": "카산드라",
      "text": "정말 멋지게 다 처리했구나! 이 정도면 이제 은신처 바로 앞이란다.",
      "startQuest": "",
      "completeQuest": "main_005",
      "next": "main_005_reward",
      "choices": []
    },
    {
      "id": "main_005_reward",
      "speaker": "카산드라",
      "text": "자, 이제 마을을 위협하는 마물들을 소탕하러 가야 할 차례란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_006_default",
      "choices": []
    },
    {
      "id": "main_006_default",
      "speaker": "카산드라",
      "text": "마물들이 이 모든 혼란의 원흉일 거란다. 어서 소탕해서 던전을 평화롭게 만들어주겠니?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "제가 처리할게요.",
          "next": "main_006_accept",
          "startQuest": "main_006",
          "completeQuest": ""
        },
        {
          "text": "조금 더 준비가 필요해요.",
          "next": "main_006_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_006_accept",
      "speaker": "카산드라",
      "text": "선생님은 너를 믿는단다. 절대 무리해서 다치면 안 돼.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_006_reject",
      "speaker": "카산드라",
      "text": "그래, 항상 철저히 대비하는 자세가 중요하지.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_006_running",
      "speaker": "카산드라",
      "text": "조금 시간이 걸리나 보구나. 조급해하지 말고 무리하지 마렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_006_complete",
      "speaker": "카산드라",
      "text": "모두 깔끔하게 소탕했단 말이니?! 훌륭하구나! 이제 녹색 밀림에 평화가 찾아오겠어.",
      "startQuest": "",
      "completeQuest": "main_006",
      "next": "main_006_reward",
      "choices": []
    },
    {
      "id": "main_006_reward",
      "speaker": "카산드라",
      "text": "정말 큰일을 해냈단다, 대견하구나! 하지만 다음 단계로 가려면 동료가 한 명 더 필요하단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_007_default",
      "choices": []
    },
    {
      "id": "main_007_default",
      "speaker": "카산드라",
      "text": "‘라이아’라는 아이를 찾아가 보렴. 마음을 잡지 못하고 방황 중이라는데, 따뜻한 너라면 마음을 열 수 있을 거란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "제가 가서 설득해 볼게요.",
          "next": "main_007_accept",
          "startQuest": "main_007",
          "completeQuest": ""
        },
        {
          "text": "나중에 찾아갈게요.",
          "next": "main_007_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_007_accept",
      "speaker": "카산드라",
      "text": "고마워라. 너의 진심 어린 모습에 라이아도 마음을 열어줄 거야.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_007_reject",
      "speaker": "카산드라",
      "text": "그래, 너의 생각을 존중하마. 준비되면 말해주렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_007_running",
      "speaker": "카산드라",
      "text": "라이아와 이야기는 나누어 보았니? 처음엔 마음을 열기 어렵겠지만 차분히 다가가 보렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_008_default",
      "speaker": "카산드라",
      "text": "라이아까지 합류해서 정말 든든하구나. 이번엔 화염 지대란다. 이상 마력이 감지되었는데, 원인을 파악해 줄 수 있겠니?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "화염 지대로 출발해요.",
          "next": "main_008_accept",
          "startQuest": "main_008",
          "completeQuest": ""
        },
        {
          "text": "잠시 정비가 필요해요.",
          "next": "main_008_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_008_accept",
      "speaker": "카산드라",
      "text": "화염 지대는 환경이 무척 가혹하단다. 화상 입지 않게 주의하렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_008_reject",
      "speaker": "카산드라",
      "text": "그래, 위험한 지역이니 장비를 단단히 갖추고 떠나자꾸나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_008_running",
      "speaker": "카산드라",
      "text": "화염 지대 안쪽은 무척 뜨거울 텐데, 다친 곳은 없니? 걱정되는구나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_008_complete",
      "speaker": "카산드라",
      "text": "던전을 잘 둘러보고 왔구나. 혹시 마력 폭주의 원인은 알아냈니?",
      "startQuest": "",
      "completeQuest": "main_008",
      "next": "main_008_reward",
      "choices": []
    },
    {
      "id": "main_008_reward",
      "speaker": "카산드라",
      "text": "새끼 드래곤들이 폭주하고 있다니... 더 큰 위험으로 번지기 전에 어서 진정시켜야겠구나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_009_default",
      "choices": []
    },
    {
      "id": "main_009_default",
      "speaker": "카산드라",
      "text": "폭주하는 새끼 드래곤들을 퇴치해 주렴. 더 크게 자라기 전에 손을 써야 한단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "새끼 드래곤들을 막을게요.",
          "next": "main_009_accept",
          "startQuest": "main_009",
          "completeQuest": ""
        },
        {
          "text": "생각 좀 해볼게요.",
          "next": "main_009_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_009_accept",
      "speaker": "카산드라",
      "text": "드래곤은 불을 뿜어대니 각별히 조심해야 한단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_009_reject",
      "speaker": "카산드라",
      "text": "그래, 준비가 온전히 마치면 바로 시작해 주렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_009_running",
      "speaker": "카산드라",
      "text": "드래곤들은 잘 해결되고 있니? 불길에 데이지 않게 항상 거리 조절을 하렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_009_complete",
      "speaker": "카산드라",
      "text": "모두 퇴치해 주었구나! 덕분에 드래곤들의 폭주가 조금 가라앉은 것 같단다.",
      "startQuest": "",
      "completeQuest": "main_009",
      "next": "main_009_reward",
      "choices": []
    },
    {
      "id": "main_009_reward",
      "speaker": "카산드라",
      "text": "하지만 근본적인 원인을 해결해야 해. 던전 깊은 곳에 있는 근원을 상대하러 가야 할 것 같구나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_010_default",
      "choices": []
    },
    {
      "id": "main_010_default",
      "speaker": "카산드라",
      "text": "화염 지대를 다스리는 보스를 퇴치해 주겠니? 그래야 비로소 이 지역이 완전히 안정될 거란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "불의 주인을 처치하고 올게요.",
          "next": "main_010_accept",
          "startQuest": "main_010",
          "completeQuest": ""
        },
        {
          "text": "조금 더 준비하고 갈게요.",
          "next": "main_010_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_010_accept",
      "speaker": "카산드라",
      "text": "부디 무사히, 다치지 말고 다녀오렴. 기다리고 있을게.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_010_reject",
      "speaker": "카산드라",
      "text": "좋은 생각이야. 위험한 상대인 만큼 철저히 준비하고 가자꾸나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_010_running",
      "speaker": "카산드라",
      "text": "불의 주인과의 싸움은 진행 중이니? 강적이니까 끝까지 절대 방심하면 안 된다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_010_complete",
      "speaker": "카산드라",
      "text": "정말 훌륭하게 해냈구나! 참으로 자랑스럽다. 이제 화염 지대도 안정을 찾겠어.",
      "startQuest": "",
      "completeQuest": "main_010",
      "next": "main_010_reward",
      "choices": []
    },
    {
      "id": "main_010_reward",
      "speaker": "카산드라",
      "text": "수고 많았단다. 하지만 앞으로는 더 힘든 여정이 될 거야. 동료를 한 명 더 영입하는 게 안전하겠구나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_011_default",
      "choices": []
    },
    {
      "id": "main_011_default",
      "speaker": "카산드라",
      "text": "‘페이’라는 아이가 있단다. 우리 소대를 강화하려면 그 친구의 힘이 꼭 필요해요. 가서 얘기 한번 해볼래?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "페이를 만나러 갈게요.",
          "next": "main_011_accept",
          "startQuest": "main_011",
          "completeQuest": ""
        },
        {
          "text": "나중에 찾아갈게요.",
          "next": "main_011_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_011_accept",
      "speaker": "카산드라",
      "text": "고마워라. 페이는 분명 너희에게 아주 도움이 되는 동료가 되어줄 거란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_011_reject",
      "speaker": "카산드라",
      "text": "그래, 서두르지 말고 마음의 준비가 되면 천천히 다녀오렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_011_running",
      "speaker": "카산드라",
      "text": "페이는 만나보았니? 기운차게 잘 이야기해 보렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_011_complete",
      "speaker": "카산드라",
      "text": "페이까지 합류해 주었구나! 이제 정말 완벽하고 훌륭한 파티가 되었어.",
      "startQuest": "",
      "completeQuest": "main_011",
      "next": "main_011_reward",
      "choices": []
    },
    {
      "id": "main_011_reward",
      "speaker": "카산드라",
      "text": "자, 그럼 이제 마지막 지역인 '저주받은 땅'을 조사하러 떠날 차례란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_012_default",
      "choices": []
    },
    {
      "id": "main_012_default",
      "speaker": "카산드라",
      "text": "모두가 함께해 주니 정말 마음이 든든하구나. 저주를 퍼뜨리는 '어둠의 기사'들을 처치해 주겠니?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "어둠의 기사들을 상대할게요.",
          "next": "main_012_accept",
          "startQuest": "main_012",
          "completeQuest": ""
        },
        {
          "text": "잠시 정비 중이에요.",
          "next": "main_012_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_012_accept",
      "speaker": "카산드라",
      "text": "사악한 원념에 마음이 잠식되지 않도록 늘 바른 마음을 유지하렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_012_reject",
      "speaker": "카산드라",
      "text": "그래, 조급해할 필요 없단다. 차분하게 정비하렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_012_running",
      "speaker": "카산드라",
      "text": "어둠의 기사들과의 싸움은 어떠니? 원념에 휘둘리지 않도록 늘 조심해야 한단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_012_complete",
      "speaker": "카산드라",
      "text": "어둠의 기사들을 모두 물리쳤구나! 땅을 덮고 있던 원념이 한결 옅어진 게 느껴지는구나.",
      "startQuest": "",
      "completeQuest": "main_012",
      "next": "main_012_reward",
      "choices": []
    },
    {
      "id": "main_012_reward",
      "speaker": "카산드라",
      "text": "하지만 진정한 악의 근원은 던전 가장 깊숙한 곳에 숨어 있을 거란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_013_default",
      "choices": []
    },
    {
      "id": "main_013_default",
      "speaker": "카산드라",
      "text": "저주받은 땅 깊은 곳에 있는 보스를 정벌해 주겠니? 이것으로 비극의 사슬을 끊어내는 거란다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "저주의 근원을 끊어 볼게요.",
          "next": "main_013_accept",
          "startQuest": "main_013",
          "completeQuest": ""
        },
        {
          "text": "아직은 조금 부담되네요.",
          "next": "main_013_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_013_accept",
      "speaker": "카산드라",
      "text": "선생님은 우리 학생을 완벽히 믿는단다. 조심해서 무사히 다녀오렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_013_reject",
      "speaker": "카산드라",
      "text": "그래, 무척 위험한 곳이니 만반의 준비를 마치고 도전하자꾸나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_013_running",
      "speaker": "카산드라",
      "text": "보스를 상대하러 간 기척이 아직 없구나. 너무 긴장하지 말고 무사히 돌아와야 한단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_013_complete",
      "speaker": "카산드라",
      "text": "아, 정말 해냈구나! 대단해! 이제 지독했던 저주도 완전히 사라졌을 거란다.",
      "startQuest": "",
      "completeQuest": "main_013",
      "next": "main_013_reward",
      "choices": []
    },
    {
      "id": "main_013_reward",
      "speaker": "카산드라",
      "text": "그런데... 이 모든 사건의 배후에 대한 충격적인 단서를 발견했단다. 정말 믿기지가 않는구나...",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_014_default",
      "choices": []
    },
    {
      "id": "main_014_default",
      "speaker": "카산드라",
      "text": "이제 정말 마지막 결전이 다가왔구나. 떠나기 전에 나랑 잠깐 이야기 좀 나누지 않겠니?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "네, 마지막 결의를 다져요.",
          "next": "main_014_accept",
          "startQuest": "main_014",
          "completeQuest": ""
        },
        {
          "text": "잠시 숨 좀 고를게요.",
          "next": "main_014_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_014_accept",
      "speaker": "카산드라",
      "text": "고마워라. 너라는 훌륭한 학생이 있었기에 여기까지 올 수 있었단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_014_reject",
      "speaker": "카산드라",
      "text": "그래, 마지막 결전인 만큼 마음을 다잡을 시간이 필요하겠지.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_014_running",
      "speaker": "카산드라",
      "text": "출발 준비는 모두 끝났니? 마음의 각오를 단단히 다져야 한단다.",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_014_complete",
      "choices": []
    },
    {
      "id": "main_014_complete",
      "speaker": "카산드라",
      "text": "모두의 눈빛을 보니 각오가 대단하구나. 자, 이제 정말 출발해 볼까?",
      "startQuest": "",
      "completeQuest": "main_014",
      "next": "main_014_reward",
      "choices": []
    },
    {
      "id": "main_014_reward",
      "speaker": "카산드라",
      "text": "너희와 함께라면... 그 어떤 것도 두렵지 않단다. 가자꾸나, 심판의 탑으로!",
      "startQuest": "",
      "completeQuest": "",
      "next": "main_015_default",
      "choices": []
    },
    {
      "id": "main_015_default",
      "speaker": "카산드라",
      "text": "저 탑 위에 알데릭이 기다리고 있단다. 우리의 힘으로 이 잘못된 비극을 끝내자꾸나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "알데릭을 쓰러뜨리러 가요.",
          "next": "main_015_accept",
          "startQuest": "main_015",
          "completeQuest": "",
          "eventID": "EnterFinalDungeon"
        },
        {
          "text": "잠시만 기다려 주세요.",
          "next": "main_015_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_015_accept",
      "speaker": "카산드라",
      "text": "자, 가자꾸나. 우리 손으로 올바른 정답을 써 내려가는 거야.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_015_reject",
      "speaker": "카산드라",
      "text": "그래, 마지막 시험과도 같으니 실수 없도록 완벽하게 정비하고 오렴.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_015_running",
      "speaker": "카산드라",
      "text": "정신을 바짝 차려야 한단다. 알데릭은 방심할 수 없는 상대야. 바로 다시 도전해 보겠니?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": [
        {
          "text": "알데릭에게 다시 도전하러 가요.",
          "next": "main_015_accept",
          "startQuest": "",
          "completeQuest": "",
          "eventID": "EnterFinalDungeon"
        },
        {
          "text": "아직 준비가 더 필요해요.",
          "next": "main_015_reject",
          "startQuest": "",
          "completeQuest": ""
        }
      ]
    },
    {
      "id": "main_015_complete",
      "speaker": "카산드라",
      "text": "드디어 끝났구나... 정말로 길었던 싸움이 끝났어.",
      "startQuest": "",
      "completeQuest": "main_015",
      "next": "main_015_reward",
      "choices": []
    },
    {
      "id": "main_015_reward",
      "speaker": "카산드라",
      "text": "마녀라는 억울한 누명을 쓰고 희생되었던 이들도 이제 평안을 찾았을 거란다. 이 모든 것은 네 덕분이야. 정말 자랑스럽고 고맙구나.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "main_015_finished",
      "speaker": "카산드라",
      "text": "어서 오렴, 자랑스러운 우리의 영웅! 오늘은 무슨 기쁜 일로 선생님을 찾아왔니?",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    }
  ]
}