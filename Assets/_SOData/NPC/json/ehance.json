      "next": "",
      "choices": []
    },
    {
      "id": "equip_002_reject",
      "speaker": "대장장이",
      "text": "단단히 정비하고 출발하게.",
      "startQuest": "",
      "completeQuest": "",
      "next": "",
      "choices": []
    },
    {
      "id": "equip_002_running",
      "speaker": "대장장이",
