      "completeQuest": "equip_001",
      "next": "equip_001_reward",
      "choices": []
    },
    {
      "id": "equip_001_reward",
      "speaker": "대장장이",
      "text": "강화된 무기의 위력을 시험하러 던전으로 가보게!",
      "startQuest": "",
      "completeQuest": "",
      "next": "equip_002_default",
      "choices": []
    },

    {
      "id": "equip_002_default",
      "speaker": "대장장이",
