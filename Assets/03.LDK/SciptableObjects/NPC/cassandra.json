            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },


        {
            "id": "finished",
            "speaker": "카산드라",
            "text": "네가 던전을 조사해준 덕분에 마을도 안심할 수 있게 되었어.",
            "startQuest": "",
            "completeQuest": "",
            "next": "recruit_request",
            "choices": []
        },


        {
            "id": "recruit_request",
            "speaker": "카산드라",
