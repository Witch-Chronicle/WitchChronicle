                    "startQuest": "",
                    "completeQuest": ""
                }
            ]
        },
        {
            "id": "accept",
            "speaker": "카산드라",
            "text": "고마워. 던전 깊은 곳까지 들어가서 무슨 일이 일어나고 있는지 확인해줘.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },
        {
            "id": "reject",
            "speaker": "카산드라",
