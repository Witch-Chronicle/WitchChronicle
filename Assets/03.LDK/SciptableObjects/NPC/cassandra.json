            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },


        {
            "id": "running",
            "speaker": "카산드라",
            "text": "아직 던전 조사를 끝내지 못했구나. 무리하지 말고 조심해서 다녀와.",
            "startQuest": "",
            "completeQuest": "",
            "next": "",
            "choices": []
        },


        {
            "id": "complete",
            "speaker": "카산드라",
            "text": "정말 해냈구나! 던전의 이상한 마력이 사라졌어.",
            "startQuest": "",
            "completeQuest": "main_001",
            "next": "reward",
            "choices": []
        },
        {
            "id": "reward",
            "speaker": "카산드라",
